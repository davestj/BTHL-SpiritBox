// resources/windows/spiritbox.rc.in
// Windows resource script for BTHL-SpiritBox. CMake configures this (@VARS@) into the build
// directory and compiles it into the .exe so Explorer / the taskbar show the app icon and the
// File > Properties > Details pane shows version metadata. See docs/WINDOWS_PORT.md.
#include <windows.h>

// Application icon (multi-resolution .ico produced by assets/branding/generate-assets.sh).
// We use an absolute source path so the configured copy in the build tree still resolves it.
IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/assets/icons/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Beyond The Horizon Labs"
            VALUE "FileDescription",  "BTHL-SpiritBox - Paranormal Investigation Command Center"
            VALUE "FileVersion",      "@BTHL_VERSION@"
            VALUE "InternalName",     "BTHL-SpiritBox"
            VALUE "LegalCopyright",   "Copyright (c) Beyond The Horizon Labs. MIT License."
            VALUE "OriginalFilename", "BTHL-SpiritBox.exe"
            VALUE "ProductName",      "BTHL-SpiritBox"
            VALUE "ProductVersion",   "@BTHL_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
