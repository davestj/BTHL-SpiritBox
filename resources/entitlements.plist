<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for the signed, notarized BTHL-SpiritBox.app.
  - device.audio-input: required so the investigator microphone (Interactive mode) works.
  - allow-jit / unsigned-executable-memory: required by the bundled QtWebEngine (Chromium) used
    by the in-app documentation browser.
  - disable-library-validation: lets the app load the Homebrew/Qt frameworks that macdeployqt
    copies into the bundle (they are signed with a different identity / ad-hoc).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
